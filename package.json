{
  "name": "clickstrv2",
  "version": "1.0.0",
  "description": "Clickstr V2 contracts and deployment scripts",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:v2": "hardhat run scripts/deploy-v2.js",
    "deploy:v2:season": "hardhat run scripts/deploy-v2-season.js",
    "deploy:base:registry-treasury": "hardhat run scripts/deploy-base-registry-treasury.js --network base",
    "deploy:base:nft": "hardhat run scripts/deploy-base-nft.js --network base",
    "deploy:base:season:24h": "hardhat run scripts/deploy-base-season-24h.js --network base",
    "airdrop:base": "node scripts/airdrop-base-token.js",
    "node": "hardhat node",
    "antibot:smoke": "node scripts/antibot-smoke.js",
    "snapshot:migration": "node scripts/snapshot-mainnet-migration.js",
    "import:migration:base": "node scripts/import-base-migration.js"
  },
  "dependencies": {
    "js-sha3": "^0.9.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "dotenv": "^16.3.1",
    "hardhat": "^2.19.0"
  },
  "license": "MIT"
}
